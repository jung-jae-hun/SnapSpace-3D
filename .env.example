# Common
NODE_ENV=development

# Web
WEB_PORT=3300
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/api/v1

# API
API_PORT=8081
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
DATABASE_URL=postgresql://snapspace:snapspace@postgres:5432/snapspace?schema=public
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=snapspace-assets

# AI generation
AI_GENERATION_DAILY_LIMIT=20
AI_GENERATION_DEDUPE_WINDOW_MS=600000
AI_GENERATION_WORKER_ENABLED=true
AI_GENERATION_WORKER_POLL_MS=3000
AI_GENERATION_WORKER_BATCH=5
AI_GENERATION_TIMEOUT_MS=600000
AI_PROVIDER_MODE=mock
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_DEBUG=false
AI_PROVIDER_SUBMIT_PATH=/v1/image-to-3d/jobs
AI_PROVIDER_STATUS_PATH=/v1/image-to-3d/jobs/{jobId}
AI_PROVIDER_DOWNLOAD_MAX_BYTES=52428800
AI_PROVIDER_SUBMIT_JOB_ID_PATHS=jobId,id,result.id,data.id,result.jobId
AI_PROVIDER_POLL_STATUS_PATHS=status,result.status,data.status
AI_PROVIDER_POLL_PROGRESS_PATHS=progress,result.progress,data.progress
AI_PROVIDER_POLL_ERROR_CODE_PATHS=errorCode,error.code,result.error.code,data.error.code
AI_PROVIDER_POLL_ERROR_MESSAGE_PATHS=errorMessage,error.message,result.error.message,data.error.message
AI_PROVIDER_POLL_GLB_ASSET_ID_PATHS=output.glbAssetId,result.output.glbAssetId,data.output.glbAssetId
AI_PROVIDER_POLL_OBJ_ASSET_ID_PATHS=output.objAssetId,result.output.objAssetId,data.output.objAssetId
AI_PROVIDER_POLL_PREVIEW_ASSET_ID_PATHS=output.previewImageAssetId,result.output.previewImageAssetId,data.output.previewImageAssetId
AI_PROVIDER_POLL_GLB_URL_PATHS=output.glbUrl,output.modelUrl,result.output.glbUrl,result.output.modelUrl,data.output.glbUrl,data.output.modelUrl,result.model_urls.glb,result.model_urls.glb_url,model_urls.glb,model_urls.glb_url
AI_PROVIDER_POLL_OBJ_URL_PATHS=output.objUrl,result.output.objUrl,data.output.objUrl,result.model_urls.obj,result.model_urls.obj_url,model_urls.obj,model_urls.obj_url
AI_PROVIDER_POLL_PREVIEW_URL_PATHS=output.previewImageUrl,output.thumbnailUrl,result.output.previewImageUrl,result.output.thumbnailUrl,data.output.previewImageUrl,data.output.thumbnailUrl,result.thumbnail_url,thumbnail_url
AI_PROVIDER_POLL_BOUNDS_PATHS=output.bounds,result.output.bounds,data.output.bounds,result.bounds,bounds

# MinIO Console
MINIO_CONSOLE_PORT=9001
