generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  tokenVersion Int    @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenes      Scene[]

  @@index([userId])
}

model Scene {
  id        String   @id @default(cuid())
  projectId String
  name      String
  version   Int      @default(1)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  placedObjects PlacedObject[]
  sceneCommands SceneCommand[]

  @@index([projectId])
  @@index([archivedAt])
}

model SceneCommand {
  id              String   @id @default(cuid())
  sceneId         String
  userId          String
  commandId       String
  action          String
  expectedVersion Int
  payload         Json?
  result          Json?
  status          String   @default("succeeded")
  createdAt       DateTime @default(now())
  scene           Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([sceneId, commandId])
  @@index([sceneId])
  @@index([userId])
}

model ObjectDefinition {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  category         String
  tags             String[]
  modelAssetId     String?
  thumbnailAssetId String?
  defaultSize      Json?
  pivot            String?
  allowedRotations Int[]
  sockets          Json?
  placementRules   Json?
  scalable         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  placedObjects    PlacedObject[]

  @@index([category])
}

model PlacedObject {
  id                 String           @id @default(cuid())
  sceneId            String
  objectDefinitionId String
  name               String?
  position           Json
  rotationY          Float            @default(0)
  scale              Json
  params             Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  scene              Scene            @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  objectDefinition   ObjectDefinition @relation(fields: [objectDefinitionId], references: [id], onDelete: Restrict)

  @@index([sceneId])
  @@index([objectDefinitionId])
}
